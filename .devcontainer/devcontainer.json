{
    "name": "Big Data Lab",

    "dockerComposeFile": "../docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/workspaces/PBC-Lab-1",
    "runServices": [
        "workspace",
        "kafka",
        "mongodb"
    ],
    "shutdownAction": "stopCompose",

    "features": {
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21",
            "jdkDistro": "ms"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "ms-azuretools.vscode-docker",
                "vscjava.vscode-java-pack"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python"
            }
        }
    },

    "forwardPorts": [8501],
    "portsAttributes": {
        "8501": {
            "label": "Streaming dashboard",
            "onAutoForward": "openBrowser"
        }
    },

    "postCreateCommand": "python --version && java -version && pyspark --version",

    "remoteUser": "vscode"
}